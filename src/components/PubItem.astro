---
import { shortJournal, type Pub } from '../data/content';
const { p, compact = false } = Astro.props as { p: Pub; compact?: boolean };
const authors = p.authors.split(/,\s*/).map((a) => a.trim());
const isMe = (a: string) => /Baji[cć]/.test(a);
---
<article class:list={['pub', { compact }]}>
  <div class="pub-meta"><span class="pub-year">{p.year}</span>{p.preprint && <span class="pub-tag">preprint</span>}</div>
  <div class="pub-body">
    <h3 class="pub-title"><a href={`https://doi.org/${p.doi}`} target="_blank" rel="noopener">{p.title}</a></h3>
    <p class="pub-authors">{authors.map((a, i) => <>{isMe(a) ? <span class="me">{a}</span> : a}{i < authors.length - 1 ? ', ' : ''}</>)}</p>
    <p class="pub-venue"><em>{shortJournal(p.journal)}</em></p>
  </div>
</article>
<style>
  .pub { display: grid; grid-template-columns: 88px 1fr; gap: 20px; padding: 20px 0; border-top: 1px solid var(--rule); }
  .pub-meta { display: flex; flex-direction: column; gap: 6px; align-items: flex-start; }
  .pub-year { font-family: var(--f-mono); font-size: 13px; color: var(--ink-3); }
  .pub-tag { font-family: var(--f-mono); font-size: 11px; border: 1px solid var(--rule-2); border-radius: 999px; padding: 1px 7px; color: var(--ink-3); }
  .pub-title { font-family: var(--f-sans); font-size: 17px; font-weight: 550; line-height: 1.35; letter-spacing: -0.005em; }
  .pub-title a { text-decoration: none; }
  .pub-title a:hover { text-decoration: underline; }
  .pub-authors { font-size: 14px; color: var(--ink-3); margin: 6px 0 2px; }
  .pub-venue { font-size: 14px; color: var(--ink-2); margin: 0; }
  @media (max-width: 600px) { .pub { grid-template-columns: 1fr; gap: 4px; } .pub-meta { flex-direction: row; } }
</style>

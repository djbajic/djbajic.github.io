---
// Five-member community on a single carbon source; arrow width = interaction strength.
const sp = [
  { n: 'P', c: 'var(--c-magenta)', a: -90 }, { n: 'R', c: 'var(--c-cyan)', a: -18 },
  { n: 'E', c: 'var(--c-violet)', a: 54 }, { n: 'C', c: 'var(--c-olive)', a: 126 }, { n: 'S', c: 'var(--c-teal)', a: 198 },
].map((s) => ({ ...s, x: 250 + 150 * Math.cos((s.a * Math.PI) / 180), y: 225 + 150 * Math.sin((s.a * Math.PI) / 180) }));
const links: [number, number, number][] = [[0,1,5],[1,2,2],[2,3,6],[3,4,2],[4,0,3],[0,2,4],[1,3,2],[2,4,1.5],[3,0,1.5],[1,4,3]];
const seg = (i: number, j: number, off: number) => {
  const A = sp[i], B = sp[j]; const dx = B.x - A.x, dy = B.y - A.y, L = Math.hypot(dx, dy);
  const ux = dx / L, uy = dy / L, nx = -uy * off, ny = ux * off;
  return { x1: A.x + ux * 34 + nx, y1: A.y + uy * 34 + ny, x2: B.x - ux * 42 + nx, y2: B.y - uy * 42 + ny };
};
const { animate = false } = Astro.props;
---
<svg viewBox="60 20 380 400" class:list={['fig-com', { animate }]} role="img" aria-label="A five-species community with interactions of different strengths">
  <defs><marker id="ah" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="3.2" markerHeight="3.2" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="context-stroke" /></marker></defs>
  <g fill="none" stroke-linecap="round">
    {links.map(([i, j, w], k) => <line {...seg(i, j, 6)} stroke={w > 3.5 ? 'var(--ink)' : '#b9bcc6'} stroke-width={w * 0.9 + 1} marker-end="url(#ah)" class="lk" style={`--d:${k * 90}ms`} />)}
  </g>
  {sp.map((s) => <g><ellipse cx={s.x} cy={s.y} rx="30" ry="18" fill={s.c} transform={`rotate(${s.a + 90} ${s.x} ${s.y})`} /></g>)}
</svg>
<style>
  .fig-com.animate .lk { opacity: 0; transition: opacity .5s ease var(--d); }
  :global(.active) .fig-com.animate .lk { opacity: 1; }
  @media (prefers-reduced-motion: reduce) { .fig-com.animate .lk { opacity: 1; } }
</style>

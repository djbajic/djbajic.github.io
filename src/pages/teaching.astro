---
import Base from '../layouts/Base.astro';
import { teaching, people } from '../data/content';
const alumni = people.filter((p) => p.status === 'alumni');
const msc = alumni.filter((p) => /MSc/.test(p.role)).length;
const bsc = alumni.filter((p) => /BSc/.test(p.role)).length;
---
<Base title="Teaching" description={teaching.intro}>
  <section class="wrap page-head">
    <p class="eyebrow">Teaching</p>
    <h1>Learning to model living systems</h1>
    {teaching.intro && <p>{teaching.intro}</p>}
  </section>

  <section class="wrap">
    <p class="eyebrow sec-first">Courses</p>
    <div class="courses">
      {(teaching.courses ?? []).map((c) => (
        <a class="course" href={c.url || undefined} target="_blank" rel="noopener">
          {c.short && <span class="code">{c.short}</span>}
          <h2>{c.title}</h2>
          {c.where && <p class="where">{c.where}</p>}
          {c.summary && <p class="sum">{c.summary}</p>}
          {c.detail && <p class="detail">{c.detail}</p>}
          {c.url && <span class="go arrow">Study guide</span>}
        </a>
      ))}
    </div>
    {(teaching.postgrad ?? []).length > 0 && (
      <div class="pg">
        {(teaching.postgrad ?? []).map((c) => (
          <a class="pg-card" href={c.url || undefined} target="_blank" rel="noopener">
            <svg class="pg-wave" viewBox="0 0 400 60" preserveAspectRatio="none" aria-hidden="true"><path d="M0,42 C110,8 250,60 400,22 L400,60 L0,60 Z" /></svg>
            {c.short && <span class="code">{c.short}</span>}
            <h3>{c.title}</h3>
            {c.where && <p class="where">{c.where}</p>}
            {c.role && <p class="pg-role">{c.role}</p>}
            {c.summary && <p class="sum">{c.summary}</p>}
            {c.when && <p class="detail">{c.when}</p>}
            {c.url && <span class="go arrow">Course page</span>}
          </a>
        ))}
      </div>
    )}

    <p class="eyebrow sec">Workshops & schools</p>
    <ul class="ws">
      {(teaching.workshops ?? []).map((w) => (
        <li>
          <p class="when">{w.when}<span>{w.where}</span></p>
          <div>
            <h3>{w.url ? <a href={w.url} target="_blank" rel="noopener">{w.title}</a> : w.title}</h3>
            {w.role && <p class="role">{w.role}</p>}
            {w.summary && <p class="sum">{w.summary}</p>}
          </div>
        </li>
      ))}
    </ul>

    <p class="eyebrow sec">Student projects</p>
    <div class="proj">
      <div class="stats">
        <div><b>{msc}</b><span>MSc projects</span></div>
        <div><b>{bsc}</b><span>BSc projects</span></div>
      </div>
      <div>
        {teaching.projects && <p class="sum">{teaching.projects}</p>}
        <p class="links"><a href="/people/"><span class="arrow">Alumni and where they are now</span></a> <a href="/join/"><span class="arrow">Do your project with us</span></a></p>
      </div>
    </div>
  </section>
</Base>
<style>
  .sec-first { margin: 0 0 24px; }
  .sec { margin: 88px 0 24px; }
  .courses { display: grid; grid-template-columns: repeat(auto-fill, minmax(420px, 1fr)); gap: 24px; }
  .course { display: flex; flex-direction: column; border: 1px solid var(--rule); border-left: 3px solid var(--c-cyan); border-radius: 14px; padding: 28px; text-decoration: none; transition: box-shadow .2s, transform .2s; }
  .course:hover { box-shadow: 0 12px 28px -18px rgba(17,19,24,.25); transform: translateY(-2px); }
  .code { font-family: var(--f-mono); font-size: 12px; letter-spacing: .08em; color: var(--c-cyan); }
  .course h2 { font-family: var(--f-display); font-weight: 600; font-size: 30px; letter-spacing: -0.03em; margin: 6px 0 6px; }
  .where { color: var(--ink-3); font-size: 14.5px; margin: 0 0 14px; }
  .sum { color: var(--ink-2); font-size: 15.5px; margin: 0 0 10px; max-width: 64ch; }
  .detail { font-family: var(--f-mono); font-size: 12px; color: var(--ink-3); margin: 0 0 16px; }
  .pg { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 20px; margin-top: 20px; }
  .pg-card { position: relative; overflow: hidden; display: flex; flex-direction: column; border-radius: 12px; padding: 22px 22px 34px; text-decoration: none; color: #fff;
    background:
      radial-gradient(60% 70% at 12% 20%, rgba(70, 190, 170, .45), transparent 70%),
      radial-gradient(50% 60% at 88% 30%, rgba(150, 110, 210, .40), transparent 70%),
      radial-gradient(40% 50% at 60% 95%, rgba(40, 120, 220, .45), transparent 70%),
      linear-gradient(160deg, #0f3379 0%, #003265 55%, #002b57 100%);
    transition: box-shadow .2s, transform .2s; }
  .pg-card::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(rgba(255,255,255,.14) 1px, transparent 1.4px); background-size: 14px 14px; pointer-events: none; }
  .pg-card > * { position: relative; }
  .pg-card:hover { box-shadow: 0 14px 30px -18px rgba(0,43,87,.6); transform: translateY(-2px); }
  .pg-wave { position: absolute !important; left: 0; right: 0; bottom: 0; width: 100%; height: 26px; }
  .pg-wave path { fill: #afb51d; }
  .pg-card .code { color: #d6dc4a; }
  .pg-card h3 { font-family: var(--f-display); font-weight: 600; font-size: 21px; letter-spacing: -0.02em; line-height: 1.2; margin: 6px 0 4px; color: #fff; }
  .pg-card .where { color: rgba(255,255,255,.7); font-size: 13.5px; margin: 0 0 8px; }
  .pg-role { color: #d6dc4a; font-size: 14px; font-weight: 500; margin: 0 0 8px; }
  .pg-card .sum { color: rgba(255,255,255,.88); font-size: 14.5px; }
  .pg-card .detail { color: rgba(255,255,255,.65); margin: 0 0 12px; }
  .pg-card .go { color: #fff; }
  .go { font-size: 14.5px; font-weight: 500; margin-top: auto; }
  .ws { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--rule); }
  .ws li { display: grid; grid-template-columns: 200px 1fr; gap: 24px; padding: 22px 0; border-top: 1px solid var(--rule); }
  .when { font-family: var(--f-mono); font-size: 12.5px; color: var(--ink-2); margin: 3px 0 0; }
  .when span { display: block; color: var(--ink-3); margin-top: 2px; }
  .ws h3 { font-family: var(--f-display); font-weight: 600; font-size: 19px; letter-spacing: -0.015em; line-height: 1.25; }
  .ws h3 a { text-decoration: none; }
  .ws h3 a:hover { text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .role { color: var(--c-magenta); font-size: 14px; margin: 4px 0 6px; }
  .proj { display: grid; grid-template-columns: auto 1fr; gap: 48px; align-items: start; }
  .stats { display: flex; gap: 32px; }
  .stats div { display: flex; flex-direction: column; }
  .stats b { font-family: var(--f-display); font-weight: 600; font-size: 44px; letter-spacing: -0.03em; line-height: 1; }
  .stats span { font-family: var(--f-mono); font-size: 11.5px; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-3); margin-top: 6px; }
  .links { display: flex; flex-wrap: wrap; gap: 8px 28px; font-size: 15px; margin: 8px 0 0; }
  .links a { text-decoration: none; font-weight: 500; }
  @media (max-width: 760px) {
    .courses, .pg { grid-template-columns: 1fr; }
    .ws li { grid-template-columns: 1fr; gap: 6px; }
    .proj { grid-template-columns: 1fr; gap: 20px; }
  }
</style>

---
// Homepage: hero from variant B (Inter Tight, gradient statement, scale ruler),
// structure from variant A (triptych → four questions → approach → selected work → join).
import Base from '../layouts/Base.astro';
import Funders from '../components/Funders.astro';
import { site, themes, selected, shortJournal, industry } from '../data/content';
const scales = [
  { s: 'Network', c: 'var(--c-cyan)' },
  { s: 'Organism', c: 'var(--c-olive)' },
  { s: 'Community', c: 'var(--c-magenta)' },
  { s: 'Function', c: 'var(--c-violet)' },
];
---
<Base>
  <section class="hero">
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="wrap">
      <p class="eyebrow">{site.name} · Industrial Microbiology · TU Delft</p>
      <h1>{site.headline[0]} <span class="grad">{site.headline[1]}</span></h1>
      <p class="lede">{site.lede}</p>
      <div class="cta">
        <a class="btn solid" href="/research/"><span class="arrow">Our research</span></a>
        <a class="btn" href="/join/">Join the lab</a>
      </div>
      <div class="ruler" aria-label="Scales we connect">
        {scales.map((x) => <div class="tick"><span class="dot" style={`--c:${x.c}`}></span><span>{x.s}</span></div>)}
      </div>
    </div>
  </section>

  <section class="triptych wrap reveal" aria-label="From network to landscape">
    <figure>
      <div class="fig"><img src="/img/pub/home-network.webp" alt="A metabolic network with one pathway highlighted" /></div>
      <figcaption><span class="k">Networks</span> Nonrandom architecture dictates microbial evolution and ecology.</figcaption>
    </figure>
    <div class="join" aria-hidden="true">→</div>
    <figure>
      <div class="fig"><img src="/img/pub/home-epistasis.webp" alt="Epistasis: the effect of species B depends on its background" /></div>
      <figcaption><span class="k">Epistasis</span> The effect of genes, but also species, depends on their interactions.</figcaption>
    </figure>
    <div class="join" aria-hidden="true">→</div>
    <figure>
      <div class="fig"><img src="/img/pub/home-landscape.webp" alt="Stacked function landscapes over a network of genotypes or communities" /></div>
      <figcaption><span class="k">Landscapes</span> Smooth maps make complex functions predictable</figcaption>
    </figure>
  </section>

  <section class="questions wrap">
    <header class="sec-head reveal">
      <p class="eyebrow">Research program</p>
      <h2>Some questions we are trying to answer</h2>
    </header>
    <ol>
      {themes.map((t) => (
        <li class="q reveal" style={`--c:${t.color}`}>
          <a href={`/research/#${t.id}`}>
            <span class="n">{t.n}</span>
            <span class="qt">{t.question}</span>
            <span class="qs">{t.short}</span>
            <span class="go" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="approach wrap reveal">
    <div class="ap"><p class="eyebrow">Theory</p><p>Fitness landscapes, global epistasis and consumer–resource models: coarse-grained descriptions with predictive power across scales.</p></div>
    <div class="ap"><p class="eyebrow">Models</p><p>We use empirically calibrated models, from mechanistic genome-scale models of single species to functional landscapes of complex communities.</p></div>
    <div class="ap"><p class="eyebrow">Experiments</p><p>We conduct high-throughput assembly of synthetic model communities, and quantitatively dissect their physiology in bioreactors.</p></div>
  </section>

  <section class="selected wrap">
    <header class="sec-head reveal">
      <p class="eyebrow">Selected work</p>
      <h2>Recent findings</h2>
      <a class="more" href="/publications/"><span class="arrow">All publications</span></a>
    </header>
    <div class="cards">
      {selected.map((p) => (
        <a class="card reveal" href={`https://doi.org/${p.doi}`} target="_blank" rel="noopener">
          {p.image
            ? <div class="thumb"><img src={`/img/pub/${p.image}`} alt="" loading="lazy" /></div>
            : <div class="thumb noimg" style={`--c:${themes.find((t) => t.id === p.theme)?.color ?? 'var(--c-violet)'}`}><span>{p.preprint ? 'Preprint' : shortJournal(p.journal)}</span><i>{p.year}</i></div>}
          <p class="venue">{shortJournal(p.journal)} · {p.year}</p>
          <h3>{p.title}</h3>
          {p.summary && <p class="sum">{p.summary}</p>}
        </a>
      ))}
    </div>
  </section>

  <section class="funding wrap reveal">
    <div class="fund-head"><p class="eyebrow">Supported by</p></div>
    <Funders />
  </section>

  {industry.length > 0 && (
    <section class="industry wrap">
      <header class="sec-head reveal">
        <p class="eyebrow">Industry partners</p>
        <h2>We help develop microbial solutions across industries</h2>
      </header>
      <div class="ind-cards">
        {industry.map((c) => (
          <a class="ind-card reveal" href={c.url} target="_blank" rel="noopener">
            <div class="ind-thumb">{c.logo ? <img src={encodeURI(`/img/partners/${c.logo}`)} alt={c.name} loading="lazy" /> : <span class="co">{c.name}</span>}</div>
            <p class="venue">{c.place}</p>
            <h3>{c.name}</h3>
            {c.summary && <p class="sum">{c.summary}</p>}
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="cta-band wrap reveal">
    <h2>Curious about how metabolism shapes ecology and evolution?</h2>
    <p>We welcome PhD, postdoc and MSc/BSc candidates with backgrounds in biology, physics, engineering, computer science, or similar.</p>
    <a class="btn solid" href="/join/"><span class="arrow">Working with us</span></a>
  </section>
</Base>


<style>
  /* ---- Hero (from B) ---- */
  .hero { position: relative; padding: clamp(64px, 10vw, 128px) 0 64px; overflow: hidden; }
  .grid-bg {
    position: absolute; inset: 0; z-index: -1; opacity: .55;
    background-image: radial-gradient(circle, #c9ccd4 1px, transparent 1.2px);
    background-size: 22px 22px;
    mask-image: linear-gradient(to bottom, #000 30%, transparent 95%);
    -webkit-mask-image: linear-gradient(to bottom, #000 30%, transparent 95%);
  }
  .hero h1 {
    font-family: var(--f-display); font-weight: 600; font-size: clamp(34px, 5vw, 68px); line-height: 1.04;
    letter-spacing: -0.035em; margin-top: 20px; max-width: 21ch;
  }
  .grad {
    font-weight: 400;
    background: linear-gradient(90deg, var(--c-cyan), var(--c-magenta) 55%, var(--c-violet));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .lede { max-width: 60ch; font-size: 19px; color: var(--ink-2); margin-top: 32px; }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 28px; }
  .ruler { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 64px; border-top: 1px solid var(--ink); max-width: 880px; }
  .tick { position: relative; padding-top: 14px; font-family: var(--f-mono); font-size: 13px; letter-spacing: .06em; text-transform: uppercase; display: flex; gap: 8px; align-items: center; }
  .tick::before { content: ''; position: absolute; left: 0; top: -1px; width: 1px; height: 10px; background: var(--ink); }
  .tick .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--c); }
  @media (max-width: 700px) { .lede { font-size: 17px; } .ruler { grid-template-columns: repeat(2, 1fr); row-gap: 10px; } }

  /* ---- Structure (from A) ---- */
  .triptych { display: grid; grid-template-columns: 1fr 24px 1fr 24px 1fr; gap: 20px; align-items: start; padding-top: 32px; padding-bottom: 32px; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .triptych figure { margin: 0; }
  .triptych .fig { position: relative; aspect-ratio: 1 / 1; width: 80%; margin: 0 auto; }
  .triptych .fig img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .triptych .join { align-self: center; color: var(--ink-3); font-size: 22px; text-align: center; margin-top: -40px; }
  figcaption { font-size: 14px; color: var(--ink-2); margin-top: 12px; line-height: 1.5; }
  figcaption .k { display: block; font-family: var(--f-mono); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink); margin-bottom: 2px; }
  @media (max-width: 820px) {
    .triptych { grid-template-columns: 1fr; }
    .triptych .join { transform: rotate(90deg); margin: 0; }
  }

  .sec-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 24px; margin-bottom: 28px; }
  .sec-head .eyebrow { width: 100%; margin: 0; }
  .sec-head h2 { font-family: var(--f-display); font-weight: 600; font-size: clamp(28px, 3.4vw, 42px); letter-spacing: -0.03em; }
  .sec-head .more { margin-left: auto; font-size: 15px; text-decoration: none; color: var(--ink-2); }

  .questions { padding-top: 112px; }
  .questions ol { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--rule); }
  .q a {
    display: grid; grid-template-columns: 72px minmax(0, 1.25fr) minmax(0, 1fr) 32px; gap: 28px; align-items: baseline;
    padding: 30px 0; border-top: 1px solid var(--rule); text-decoration: none; position: relative;
  }
  .q a::before { content: ''; position: absolute; left: 0; top: -1px; height: 2px; width: 0; background: var(--c); transition: width .5s ease; }
  .q a:hover::before { width: 100%; }
  .q .n { font-family: var(--f-mono); font-size: 14px; color: var(--c); font-weight: 500; }
  .q .qt { font-family: var(--f-display); font-weight: 600; font-size: clamp(21px, 2.3vw, 28px); line-height: 1.18; letter-spacing: -0.025em; }
  .q .qs { color: var(--ink-3); font-size: 15.5px; }
  .q .go { color: var(--ink-3); transition: transform .2s, color .2s; justify-self: end; }
  .q a:hover .go { transform: translateX(4px); color: var(--c); }
  @media (max-width: 820px) { .q a { grid-template-columns: 44px 1fr; gap: 8px 12px; } .q .qs { grid-column: 2; } .q .go { display: none; } }

  .approach { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; padding-top: 96px; }
  .approach .ap { border-left: 2px solid var(--ink); padding-left: 18px; }
  .approach .ap:nth-child(1) { border-color: var(--c-cyan); }
  .approach .ap:nth-child(2) { border-color: var(--c-olive); }
  .approach .ap:nth-child(3) { border-color: var(--c-magenta); }
  .approach p:last-child { font-size: 15.5px; color: var(--ink-2); margin: 8px 0 0; }
  @media (max-width: 820px) { .approach { grid-template-columns: 1fr; gap: 24px; } }

  .selected { padding-top: 112px; }
  .cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; }
  .card { text-decoration: none; display: flex; flex-direction: column; }
  .thumb { aspect-ratio: 4 / 3; background: var(--paper-2); border-radius: var(--radius); overflow: hidden; display: grid; place-items: center; margin-bottom: 14px; transition: box-shadow .2s; }
  .thumb img { width: 100%; height: 100%; object-fit: contain; padding: 14px; background: #fff; transition: transform .4s ease; }
  .card:hover .thumb img { transform: scale(1.03); }
  .thumb.noimg { background: color-mix(in srgb, var(--c) 9%, #fff); display: flex; flex-direction: column; align-items: flex-start; justify-content: flex-end; padding: 18px; gap: 2px; position: relative; overflow: hidden; }
  .thumb.noimg::before { content: ''; position: absolute; right: -30%; top: -40%; width: 90%; aspect-ratio: 1; border-radius: 50%; border: 18px solid color-mix(in srgb, var(--c) 22%, transparent); }
  .thumb.noimg span { font-family: var(--f-display); font-weight: 600; font-size: 24px; letter-spacing: -0.02em; color: var(--c); }
  .thumb.noimg i { font-style: normal; font-family: var(--f-mono); font-size: 12px; color: var(--ink-3); }
  .card:hover .thumb { box-shadow: 0 0 0 1px var(--rule-2); }
  .venue { font-family: var(--f-mono); font-size: 12px; color: var(--ink-3); margin: 0 0 6px; }
  .card h3 { font-family: var(--f-display); font-size: 17.5px; font-weight: 600; line-height: 1.25; letter-spacing: -0.015em; }
  .card:hover h3 { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .sum { font-size: 14.5px; color: var(--ink-2); margin: 8px 0 0; }
  @media (max-width: 1000px) { .cards { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .cards { grid-template-columns: 1fr; } }

  .funding { margin-top: 112px; display: grid; grid-template-columns: 200px 1fr; gap: 24px; padding-top: 28px; border-top: 1px solid var(--rule); }
  .fund-head .eyebrow { margin: 10px 0 0; }
  @media (max-width: 700px) { .funding { grid-template-columns: 1fr; } }
  .industry { padding-top: 112px; }
  .ind-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  .ind-card { text-decoration: none; display: flex; flex-direction: column; }
  .ind-thumb { height: 230px; background: #fff; border: 1px solid var(--rule); border-radius: var(--radius); display: flex; align-items: center; justify-content: center; margin-bottom: 14px; padding: 32px; overflow: hidden; transition: box-shadow .2s; }
  .ind-thumb img { max-width: 80%; max-height: 150px; width: auto; height: auto; object-fit: contain; transition: transform .4s ease; }
  .ind-thumb .co { font-family: var(--f-display); font-weight: 600; font-size: 28px; letter-spacing: -0.02em; }
  .ind-card:hover .ind-thumb { box-shadow: 0 0 0 1px var(--rule-2); }
  .ind-card:hover .ind-thumb img { transform: scale(1.04); }
  .ind-card h3 { font-family: var(--f-display); font-size: 19px; font-weight: 600; letter-spacing: -0.015em; }
  .ind-card:hover h3 { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  @media (max-width: 900px) { .ind-cards { grid-template-columns: 1fr; } }
  .cta-band { margin-top: 96px; padding-top: 56px; padding-bottom: 8px; border-top: 1px solid var(--ink); }
  .cta-band h2 { font-family: var(--f-display); font-weight: 600; font-size: clamp(26px, 3.2vw, 40px); max-width: 24ch; letter-spacing: -0.03em; }
  .cta-band p { color: var(--ink-2); margin: 16px 0 24px; max-width: 60ch; }
</style>
